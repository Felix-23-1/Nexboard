# ─────────────────────────────────────────────────
#  Nexboard – Konfiguration
#  Kopiere diese Datei zu .env und passe die Werte an.
#  Dann: docker compose up -d
# ─────────────────────────────────────────────────

# Port auf dem Nexboard erreichbar ist (Standard: 8080)
# Mit Reverse Proxy (NPM, Traefik): 8080 kann so bleiben, der Port ist dann nur intern.
PORT=8080

# JWT-Secret für Token-Signierung.
# Leer lassen → wird automatisch generiert und unter nexboard-data/.jwt_secret gespeichert.
# Für ein festes Secret (Logins bleiben nach Container-Rebuild gültig):
#   openssl rand -hex 32
NEXBOARD_JWT_SECRET=

# CORS-Origins – nur nötig wenn du die API direkt ohne nginx-Proxy ansprichst.
# Standard-Betrieb über nginx: leer lassen.
CORS_ORIGINS=
